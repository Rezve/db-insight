# Build artifacts — recreated inside the container
node_modules
.next
npm-debug.log*
yarn-debug.log*
yarn-error.log*
tsconfig.tsbuildinfo

# Local data — never bake state into the image; use a volume mount
data/

# Environment files — secrets must come from env vars at runtime, not the image
.env
.env.local
.env.development
.env.production
.env*.local

# Git
.git
.gitignore
.gitattributes

# IDE and OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Documentation
*.md

# Tests
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
__tests__/
